      </Conditions>
      <Events>
        <StoryEvent Type="DiscoverCharacterName" Subject="Target" Object="Actor" ObjectModifier="Leader" />
      </Events>
    </Speech>
    <Speech UniqueID="Mining_WantAPiece" x="2197.99829" y="-1698.12976" NativeText="Oh you want a piece of our %1 operation do you?  Sure, I guess I could let you work the mine, for a price.  Say, 500 gold pieces.">
