      <Replies>
        <SpeechRef UniqueID="Bunnies_CanUseBow" />
        <SpeechRef UniqueID="Bunnies_CanUseGun" />
        <SpeechRef UniqueID="Bunnies_ExpertMarksman" />
        <SpeechRef UniqueID="Bunnies_No" />
