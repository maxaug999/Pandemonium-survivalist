    </Speech>
    <Speech UniqueID="Bunnies_MyHelp" x="9302.401" y="-6246.093" NativeText="}:-| You don't want my help, don't ask for it!" />
    <Speech UniqueID="Bunnies_NoProblem" x="9301.189" y="-5312.62451" NativeText=":-) No problem." />
    <Speech UniqueID="Bunnies_HmmOkay" x="8202.372" y="-8294.416" NativeText="Hmm, okay." />
    <Speech UniqueID="Bunnies_ABetterWay" x="8209.289" y="-7163.474" NativeText="}:-| Uh thanks, I hadn't thought about creeping up on them.  I was gonna just run at them hollering but you've shown me a better way.">
      <Replies>
        <SpeechRef UniqueID="Bunnies_MyHelp" />
