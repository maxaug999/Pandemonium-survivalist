  <Speeches>
    <Speech UniqueID="LostItem_LostSomeSupplies" x="-5280.83643" y="88.38873" NativeText="I wanted to talk to you.. {:-| I lost some supplies in one of the towns here a while back.  Infected had us surrounded, and I had to abandon my pack to get out.">
      <PriorityTerms>
        <Condition Type="Always" PriorityFactor="1.1" />
      </PriorityTerms>
      <Continues>
        <SpeechRef UniqueID="LostItem_CanYouHelp" />
      </Continues>
      <Conditions>
        <Condition Type="IsConditionBlockSatisfied">
          <ConditionBlocks>
            <ConditionBlockRef UniqueID="LostItem_ConditionBlock_CanStart" />
          </ConditionBlocks>
        </Condition>
      </Conditions>
      <ExtraReplyTo>
        <SpeechRef UniqueID="Gossip_WhatsUp" />
      </ExtraReplyTo>
    </Speech>
    <Speech UniqueID="LostItem_CanYouHelp" x="-4291.601" y="26.1690674" NativeText="I've been meaning to go back there and search for something that was in it, in case it's still there.  Can you help?">
      <Replies>
        <SpeechRef UniqueID="LostItem_ImDown" />
        <SpeechRef UniqueID="LostItem_LongGone" />
      </Replies>
    </Speech>
    <Speech UniqueID="LostItem_ImDown" x="-3273.97021" y="260.907959" NativeText="I'm down to help with that.">
      <Replies>
        <SpeechRef UniqueID="LostItem_CountOnYou" />
      </Replies>
    </Speech>
    <Speech UniqueID="LostItem_LongGone" x="-3269.78" y="-636.3015" NativeText="Nah, it'll be long gone by now.">
      <Replies>
        <SpeechRef UniqueID="LostItem_IfYouSaySo" />
      </Replies>
    </Speech>
    <Speech UniqueID="LostItem_CountOnYou" x="-2017.491" y="628.345337" NativeText=":-) Thanks man, knew I could count on you.">
      <Events>
        <StoryEvent Type="SpawnTemplate" StringData="LostItem_CarbonArrows" />
        <StoryEvent Type="SpawnTemplate" StringData="LostItem_FencingBook" />
        <StoryEvent Type="SpawnTemplate" StringData="LostItem_CraftingBook" />
        <StoryEvent Type="SpawnTemplate" StringData="LostItem_BodyArmor" />
        <StoryEvent Type="SpawnTemplate" StringData="LostItem_CookBook" />
        <StoryEvent Type="SpawnTemplate" StringData="LostItem_Katana" />
        <StoryEvent Type="SpawnTemplate" StringData="LostItem_CultistManifesto" />
        <StoryEvent Type="SpawnTemplate" StringData="LostItem_DrillSargeantsCap" />
        <StoryEvent Type="SpawnTemplate" StringData="LostItem_SilencedPistol" />
        <StoryEvent Type="SpawnTemplate" StringData="LostItem_Vitamins" />
      </Events>
    </Speech>
    <Speech UniqueID="LostItem_IfYouSaySo" x="-2002.58508" y="-978.007446" NativeText="}:-| Right.  I guess so.">
      <UninterruptibleEvents>
        <StoryEvent Type="MemorableEvent" Subject="Target" Object="Actor" StringData="RefusedToHangOut" />
      </UninterruptibleEvents>
    </Speech>
    <Speech UniqueID="LostItem_OldBodyArmor" x="6034.85547" y="430.9045" NativeText="It's this old body armor that I found in a wrecked limo in the early days of the infection.  Very high grade.  It belonged to some important politician, a senator I think, didn't help her much but it saved my ass more times than I can remember and I always repaired it after it got damaged." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Continues>
        <SpeechRef UniqueID="LostItem_KeptForYears" />
      </Continues>
    </Speech>
    <Speech UniqueID="LostItem_KeptForYears" x="7035.894" y="253.128265" NativeText="I kept it with me for years until I finally left it behind that night in %1.  It'd be awesome to have it back, I always felt a little safer when I was wearing it.">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
      </Params>
    </Speech>
    <Speech UniqueID="LostItem_EnhancedCooking" x="6049.56934" y="-369.193" NativeText="It was back in %1 that I lost my gourmet recipe book.  Don't ask me why, but that book really enhanced my cooking abilities, even though we don't have most of the ingredients these days.  I'd love the chance to go back there and dig it out." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
      </Params>
    </Speech>
    <Speech UniqueID="LostItem_BeautifulAntique" x="6082.2334" y="-1337.62988" NativeText="What happened was I had this beautiful antique katana, pretty sure it was the real deal.  Looted from the back of an antique store.  It would cut through anything." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Continues>
        <SpeechRef UniqueID="LostItem_WentOffToPee" />
      </Continues>
    </Speech>
    <Speech UniqueID="LostItem_WentOffToPee" x="7061.76367" y="-1351.624" NativeText="I always kept it close by in case of danger, except this one time in %1 when I just went off to pee and what do you know, that's exactly when the infected showed up.">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
      </Params>
    </Speech>
    <Speech UniqueID="LostItem_YouComing" x="9744.009" y="3992.03076" NativeText=":-) Hey %1 shall we look for my %2?  I'm in %3 right now." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="FirstName" Subject="Target" />
        <SpeechParam Type="ItemName" Subject="ReferringTo" />
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
      </Params>
      <Conditions>
        <Condition Type="HasPersonality" Subject="Actor" StringData="Passive-Aggressive" Not="true" />
      </Conditions>
    </Speech>
    <Speech UniqueID="LostItem_MoreImportantThings" x="9751.659" y="3053.93481" NativeText="}:-| Should I just search all over %1 for my %2 by myself?  It's gonna be difficult to find, but I guess you had more important things to do." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
        <SpeechParam Type="ItemName" Subject="ReferringTo" />
      </Params>
      <Conditions>
        <Condition Type="HasPersonality" Subject="Actor" StringData="Passive-Aggressive" />
      </Conditions>
    </Speech>
    <Speech UniqueID="LostItem_WithoutMe" x="9736.812" y="4970.554" NativeText="}:-| Oh you went to %1?  That's cool.  I guess you could search for my %2 while you're there, but I don't know how you're gonna find it without me." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
        <SpeechParam Type="ItemName" Subject="ReferringTo" />
      </Params>
      <Conditions>
        <Condition Type="HasPersonality" Subject="Actor" StringData="Passive-Aggressive" />
      </Conditions>
    </Speech>
    <Speech UniqueID="LostItem_ICouldComeOver" x="9734.3" y="5904.858" NativeText=":-) Hey %1 you're in %2?  I could come over there and look for my %3?" CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="FirstName" Subject="Target" />
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
        <SpeechParam Type="ItemName" Subject="ReferringTo" />
      </Params>
      <Conditions>
        <Condition Type="HasPersonality" Subject="Actor" StringData="Passive-Aggressive" Not="true" />
      </Conditions>
    </Speech>
    <Speech UniqueID="LostItem_WhereILostMy" x="9794.706" y="8677.344" NativeText="%1.  This is where I lost my %2.  It'll be round here somewhere but I don't know exactly where, it was chaotic that night and the infected may have messed everything up since then." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
        <SpeechParam Type="ItemName" Subject="ReferringTo" />
      </Params>
      <Conditions>
        <Condition Type="HasPersonality" Subject="Actor" StringData="Nervous" Not="true" />
        <Condition Type="HasPersonality" Subject="Actor" StringData="Bold" Not="true" />
      </Conditions>
    </Speech>
    <Speech UniqueID="LostItem_TakenBySurprise" x="9798.089" y="7626.16162" NativeText="%1.  This is where I lost my %2.  8-| Watch out for infected, we don't want to get taken by surprise like we were that night." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
        <SpeechParam Type="ItemName" Subject="ReferringTo" />
      </Params>
      <Conditions>
        <Condition Type="HasPersonality" Subject="Actor" StringData="Nervous" />
      </Conditions>
    </Speech>
    <Speech UniqueID="LostItem_PaybackTime" x="9788.812" y="6792.53174" NativeText="%1.  }:-) It's time to pay back those infected for making me lose my %2!" CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
        <SpeechParam Type="ItemName" Subject="ReferringTo" />
      </Params>
      <Conditions>
        <Condition Type="HasPersonality" Subject="Actor" StringData="Bold" />
      </Conditions>
    </Speech>
    <Speech UniqueID="LostItem_FoundIt" x="9755.431" y="1960.60986" NativeText=":-) We found it!  My %1!" MustFinish="true" AIOverridesControl="true" AIOverridesListenerControl="true">
      <Params>
        <SpeechParam Type="ItemName" Subject="ReferringTo" />
      </Params>
      <Continues>
        <SpeechRef UniqueID="LostItem_SoCute" />
        <SpeechRef UniqueID="LostItem_AnOffer" />
        <SpeechRef UniqueID="LostItem_HearSomething" />
        <SpeechRef UniqueID="LostItem_ThanksForHelping" />
      </Continues>
      <Events>
        <StoryEvent Type="SurpriseSaveGameOverwrite" />
      </Events>
    </Speech>
    <Speech UniqueID="LostItem_AnOffer" x="11079.6523" y="4163.619" NativeText="Now that we're alone here... {:-| I'm sorry about this, man.  You know I like and respect you personally but... :-| they made me an offer I couldn't refuse." MustFinish="true" Run="true" AIOverridesControl="true" AIOverridesListenerControl="true">
      <PriorityTerms>
        <Condition Type="Always" PriorityFactor="2" />
      </PriorityTerms>
      <Conditions>
        <Condition Type="HasPersonality" Subject="Actor" StringData="Moral" Not="true" />
        <Condition Type="HasPersonality" Subject="Actor" StringData="Loyal" Not="true" />
        <Condition Type="Or">
          <ConditionBlocks>
            <ConditionBlockRef UniqueID="LostItem_IsEvil_Fickle" />
            <ConditionBlockRef UniqueID="LostItem_IsEvil_NotFickle" />
          </ConditionBlocks>
        </Condition>
        <Condition Type="AreApparentlyAloneTogether" Subject="Actor" Object="Target" Data="40" />
      </Conditions>
      <UninterruptibleEvents>
        <StoryEvent Type="MemorableEvent" Subject="Actor" Object="Target" StringData="Betrayed" />
        <StoryEvent Type="SpawnTemplate" StringData="LostItem_Template_Hunters" />
      </UninterruptibleEvents>
    </Speech>
    <Speech UniqueID="LostItem_ThanksForHelping" x="11042.8154" y="692.902344" NativeText=":-) Thanks for helping me out!  Let's go back home." MustFinish="true" AIOverridesControl="true" AIOverridesListenerControl="true">
      <Events>
        <StoryEvent Type="MemorableEvent" Subject="Actor" Object="Target" StringData="HungOut" />
        <StoryEvent Type="MemorableEvent" Subject="Target" Object="Actor" StringData="Assisted" />
      </Events>
    </Speech>
    <Speech UniqueID="LostItem_SoCute" x="11071.6709" y="5351.00537" NativeText="It's so cute that you went out of your way to help me, because you wanted us to be friends." MustFinish="true" Run="true" AIOverridesControl="true" AIOverridesListenerControl="true">
      <PriorityTerms>
        <Condition Type="Always" PriorityFactor="3" />
      </PriorityTerms>
      <Conditions>
        <Condition Type="HasInvisibleStrain" Subject="Actor" />
        <Condition Type="AreApparentlyAloneTogether" Subject="Actor" Object="Target" Data="40" />
      </Conditions>
      <UninterruptibleEvents>
        <StoryEvent Type="ActivateInvisibleStrain" Subject="Actor" />
        <StoryEvent Type="SurpriseSaveGameOverwrite" />
      </UninterruptibleEvents>
    </Speech>
    <Speech UniqueID="LostItem_HearSomething" x="11077.28" y="1891.773" NativeText=":-) Thanks for helping me.. 8-| wait, do you hear something?" MustFinish="true" CanTalkOutOfRange="true" AIOverridesControl="true" AIOverridesListenerControl="true">
      <PriorityTerms>
        <Condition Type="Always" PriorityFactor="1" />
      </PriorityTerms>
      <Conditions>
        <Condition Type="DeterministicRandom" Subject="Actor" Data="2" Data2="1" StringData="ZombieAttack" />
      </Conditions>
      <UninterruptibleEvents>
        <StoryEvent Type="SpawnTemplate" StringData="LostItem_Template_Zombies" />
        <StoryEvent Type="SurpriseSaveGameOverwrite" />
      </UninterruptibleEvents>
    </Speech>
    <Speech UniqueID="LostItem_HidingSomewhere" x="15090.8115" y="1207.50427" NativeText="{:-| Shit, those were the infected that attacked us before!  Must have been hiding somewhere.  Jesus, I'm glad you were around to help out this time." MustFinish="true" CanTalkOutOfRange="true" AIOverridesControl="true" AIOverridesListenerControl="true">
      <UninterruptibleEvents>
        <StoryEvent Type="MemorableEvent" Subject="Actor" Object="Target" StringData="HungOut" />
        <StoryEvent Type="MemorableEvent" Subject="Target" Object="Actor" StringData="Protected" />
      </UninterruptibleEvents>
    </Speech>
    <Speech UniqueID="LostItem_BestDIYManual" x="6018.403" y="1093.16431" NativeText="It was the best D.I.Y. manual I ever found, gave me all sorts of good ideas.  I've been really off my game since I lost it in %1." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
      </Params>
    </Speech>
    <Speech UniqueID="LostItem_BookAboutFencing" x="6000.90771" y="1745.94153" NativeText="It's a book about fencing that I left in %1.  I was using it to improve my bladework.  Granted the raiders don't play by FIE rules by they'd learn a lot if they did - their technique is very sloppy." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
      </Params>
    </Speech>
    <Speech UniqueID="LostItem_MyCarbonArrows" x="5966.53467" y="2433.27954" NativeText="I lost my set of carbon fibre hunting arrows in %1.  They'd cut through anything, and never broke on me. {:-| I always retrieved them after use, every time, and they never failed me.  So I gotta go retrieve them now!" CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
      </Params>
    </Speech>
    <Speech UniqueID="LostItem_Loonabomber" x="6088.382" y="-2087.39258" NativeText="It's my copy of the Loonabomber manifesto, lost it in %1. /:-) Yeah I know, but it turned out to be a very useful survival guide!  Half of it is just ranting about how modern industrial society is stealing our souls, but the other half taught me how to strip a rifle in 15 seconds flat." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
      </Params>
      <Replies>
        <SpeechRef UniqueID="LostItem_InHisElement" />
      </Replies>
    </Speech>
    <Speech UniqueID="LostItem_InHisElement" x="6975.662" y="-2440.705" NativeText="Wonder what happened to that guy anyway?  He must be in his element now!">
      <Replies>
        <SpeechRef UniqueID="LostItem_DiedOfDysentry" />
      </Replies>
    </Speech>
    <Speech UniqueID="LostItem_DiedOfDysentry" x="7926.696" y="-2537.36377" NativeText="Nah, I heard he died of dysentery." />
    <Speech UniqueID="LostItem_ReallyNiceSilencedPistol" x="6112.147" y="-4060.21753" NativeText="I had a pistol with a really nice silencer attached.  You can imagine how useful that was! {:-| I'm kicking myself that I put it down for a few minutes in %1.  They're very hard to find nowadays." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
      </Params>
    </Speech>
    <Speech UniqueID="LostItem_MyVitamins" x="6118.41846" y="-4882.90625" NativeText="I lost my supplements in %1.  Can you believe it?  The only thing standing between me and vitamin defficiency!  Getting them back would do wonders for my wellbeing." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
      </Params>
    </Speech>
    <Speech UniqueID="LostItem_DrillSargeant" x="6095.218" y="-3108.84229" NativeText="{:-| It's this drill sargeant's cap that I lost in %1.  Inherited it from my dad, who got it from his army days.  Story is he had this bunk buddy who didn't take to the military life, ended up shooting his drill sargeant, then shot himself in the head.  Pop kept the guy's hat and passed it to me.  It's got sentimental value." CanTalkOutOfRange="true" AIOverridesControl="true">
      <Params>
        <SpeechParam Type="TownName" Subject="ReferringTo" SubjectModifier="Owner" />
      </Params>
    </Speech>
  </Speeches>
